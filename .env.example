# Telegram bot
TG_TOKEN=
TG_CHAT_MAIN=
# Thread IDs (если группа supergroup с темами; иначе оставляй пустыми)
TG_THREAD_DIGEST=
TG_THREAD_FRESH=
TG_THREAD_CLUSTER=
TG_THREAD_VOLUME=
TG_THREAD_SMART=
TG_THREAD_RESOLUTION=
TG_THREAD_ERRORS=

# Backup chat (для backup.sh daily)
TG_CHAT_BACKUP=
TG_THREAD_BACKUP=

# Alchemy (Polygon mainnet) — comma-separated FREE keys; round-robin pool
ALCHEMY_KEYS=
# Reserve (paid) Alchemy key(s), comma-separated — used ONLY after every free
# key above is rate-limited/exhausted. Leave empty if no paid key.
ALCHEMY_KEYS_RESERVE=

# Etherscan V2 (supports Polygon chainid=137 on free tier)
ETHERSCAN_KEY=

# Timezone для digest (Europe/Berlin = CET/CEST)
DIGEST_TZ=Europe/Berlin
DIGEST_HOUR=12
